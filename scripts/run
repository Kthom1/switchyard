#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export SWITCHYARD_ROOT="$PWD"
set -a
source "${2:-.env}"
set +a
workflow=$(realpath "${1:-$SWITCHYARD_ROOT/WORKFLOW.md}")
"$SWITCHYARD_ROOT/scripts/task-workspace" root
args=("$workflow" --logs-root "$SWITCHYARD_ROOT/work/log" --i-understand-that-this-will-be-running-without-the-usual-guardrails)
if [[ -x "$SWITCHYARD_ROOT/bin/symphony" ]]; then
  exec "$SWITCHYARD_ROOT/bin/symphony" "${args[@]}"
fi
cd work/symphony/elixir
exec mise exec -- ./bin/symphony "${args[@]}"
