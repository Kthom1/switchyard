#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# -gt 1 || ( $# -eq 1 && "$1" != --assemble-only ) ]]; then
  echo 'Usage: scripts/build [--assemble-only]' >&2
  exit 2
fi
if [[ -e .git ]]; then git submodule update --init; fi
if [[ -e vendor/symphony ]]; then
  echo 'vendor/symphony is no longer used and blocks packaging; see CONTRIBUTING.md to remove it.' >&2
fi
mkdir -p work/yardmaster
# Delete removed source files; rsync exclusions preserve dependency/build caches and the generated executable.
rsync -a --delete --exclude=.git --exclude=deps --exclude=_build --exclude=/elixir/bin/ vendor/yardmaster/ work/yardmaster/
for change in patches/*.patch; do
  patch --batch -d work/yardmaster -p1 < "$change"
done
cp test/*.exs work/yardmaster/elixir/test/symphony_elixir/
if [[ "${1:-}" == --assemble-only ]]; then exit 0; fi
cd work/yardmaster/elixir
mise trust
mise exec -- mix local.hex --force --if-missing
mise exec -- mix local.rebar --force --if-missing
mise exec -- mix deps.get --check-locked
mise exec -- mix build
