+  @doc false
+  @spec remove_recorded(Path.t(), worker_host(), term()) :: {:ok, [String.t()]} | {:error, term(), String.t()}
+  def remove_recorded(workspace, worker_host, %{native_ref: %{"project_id" => _}} = issue) do
+    context = issue_context(issue)
+    root = System.get_env("SWITCHYARD_ROOT")
+
+    cond do
+      worker_host == nil and not File.exists?(workspace) ->
+        {:ok, []}
+
+      not Enum.all?([context.repo_url, context.project_id, context.issue_id, root], &(is_binary(&1) and &1 != "")) ->
+        preserve_unverified_workspace(workspace)
+
+      true ->
+        safety =
+          if worker_host == nil,
+            do: validate_recorded_workspace_path(workspace),
+            else: validate_workspace_path(workspace, worker_host)
+
+        command = shell_escape(Path.join(root, "scripts/task-workspace")) <> " check"
+
+        with :ok <- safety,
+             :ok <- run_hook(command, workspace, context, "cleanup_identity", worker_host) do
+          remove_recorded(workspace, worker_host)
+        else
+          _ -> preserve_unverified_workspace(workspace)
+        end
+    end
+  end
+
+  def remove_recorded(workspace, worker_host, _issue), do: remove_recorded(workspace, worker_host)
+
+  defp preserve_unverified_workspace(workspace) do
+    Logger.warning("Preserving workspace with unverified task or repository identity: #{workspace}")
+    {:error, :workspace_identity_unverified, ""}
+  end
+
