+  @doc "Whether refreshed tracker data still refers to the accepted execution target."
+  @spec same_work_item?(t(), t()) :: boolean()
+  def same_work_item?(%__MODULE__{} = accepted, %__MODULE__{} = refreshed) do
+    accepted.id == refreshed.id and accepted.identifier == refreshed.identifier and
+      repository_binding(accepted.native_ref) == repository_binding(refreshed.native_ref)
