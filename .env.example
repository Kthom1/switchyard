# Use switchyard init, then switchyard project add, to generate private configuration.
PLANE_API_KEY=replace_with_your_plane_api_key
# Connect each Plane project to its repository with switchyard project add.
# Repository mappings are stored in WORKFLOW.md.
# Absolute directory outside all source checkouts, for example /srv/agent-tasks.
SYMPHONY_WORKSPACE_ROOT=/REPLACE_WITH_ABSOLUTE_TASK_DIRECTORY
# Codex uses your existing login and configuration. To select another Codex home,
# export CODEX_HOME in your shell before running Switchyard setup and up.
